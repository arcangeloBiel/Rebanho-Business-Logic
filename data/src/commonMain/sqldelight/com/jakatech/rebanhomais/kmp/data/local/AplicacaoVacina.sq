-- Espelha public.aplicacoes_vacina do Supabase. sync_status é só local (Fase 4).
CREATE TABLE aplicacoes_vacina (
    id TEXT NOT NULL PRIMARY KEY,
    fazenda_id TEXT NOT NULL,
    animal_id TEXT NOT NULL,
    protocolo_id TEXT,
    nome_vacina TEXT NOT NULL,
    data TEXT NOT NULL,
    dose INTEGER NOT NULL DEFAULT 1,
    lote_produto TEXT,
    observacao TEXT,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    deleted_at TEXT,
    sync_status TEXT NOT NULL DEFAULT 'PENDENTE' CHECK (sync_status IN ('PENDENTE', 'SINCRONIZADO'))
);

CREATE INDEX aplicacoes_vacina_animal_idx ON aplicacoes_vacina (fazenda_id, animal_id);
CREATE INDEX aplicacoes_vacina_sync_idx ON aplicacoes_vacina (sync_status);

contar:
SELECT count(*) FROM aplicacoes_vacina;
