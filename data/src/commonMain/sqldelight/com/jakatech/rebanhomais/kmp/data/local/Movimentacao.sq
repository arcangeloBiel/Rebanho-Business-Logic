-- Espelha public.movimentacoes do Supabase. sync_status é só local (Fase 4).
CREATE TABLE movimentacoes (
    id TEXT NOT NULL PRIMARY KEY,
    fazenda_id TEXT NOT NULL,
    animal_id TEXT NOT NULL,
    tipo TEXT NOT NULL CHECK (tipo IN ('NASCIMENTO', 'COMPRA', 'VENDA', 'MORTE', 'TRANSFERENCIA')),
    data TEXT NOT NULL,
    contraparte TEXT,
    valor REAL,
    observacao TEXT,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    deleted_at TEXT,
    sync_status TEXT NOT NULL DEFAULT 'PENDENTE' CHECK (sync_status IN ('PENDENTE', 'SINCRONIZADO'))
);

CREATE INDEX movimentacoes_animal_idx ON movimentacoes (fazenda_id, animal_id);
CREATE INDEX movimentacoes_sync_idx ON movimentacoes (sync_status);

contar:
SELECT count(*) FROM movimentacoes;

existe:
SELECT count(*) FROM movimentacoes WHERE id = ?;

inserir:
INSERT INTO movimentacoes (
    id, fazenda_id, animal_id, tipo, data, contraparte, valor, observacao, created_at, updated_at, sync_status
) VALUES (
    :id, :fazenda_id, :animal_id, :tipo, :data, :contraparte, :valor, :observacao, :agora, :agora, 'PENDENTE'
);

atualizar:
UPDATE movimentacoes SET
    fazenda_id = :fazenda_id, animal_id = :animal_id, tipo = :tipo, data = :data,
    contraparte = :contraparte, valor = :valor, observacao = :observacao,
    updated_at = :agora, sync_status = 'PENDENTE'
WHERE id = :id;

listarPorAnimal:
SELECT * FROM movimentacoes
WHERE animal_id = ? AND deleted_at IS NULL
ORDER BY data, created_at;
