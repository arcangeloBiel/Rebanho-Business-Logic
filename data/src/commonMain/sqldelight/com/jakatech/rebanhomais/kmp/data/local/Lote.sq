-- Espelha public.lotes do Supabase. sync_status é só local (Fase 4).
CREATE TABLE lotes (
    id TEXT NOT NULL PRIMARY KEY,
    fazenda_id TEXT NOT NULL,
    nome TEXT NOT NULL,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    deleted_at TEXT,
    sync_status TEXT NOT NULL DEFAULT 'PENDENTE' CHECK (sync_status IN ('PENDENTE', 'SINCRONIZADO')),
    -- Fase 4: motivo da recusa do servidor; preenchido = registro com erro, fora do envio até ser corrigido.
    sync_erro_codigo TEXT,
    sync_erro_mensagem TEXT
);

CREATE INDEX lotes_fazenda_idx ON lotes (fazenda_id);
CREATE INDEX lotes_sync_idx ON lotes (sync_status);

contar:
SELECT count(*) FROM lotes;

existe:
SELECT count(*) FROM lotes WHERE id = ?;

inserir:
INSERT INTO lotes (id, fazenda_id, nome, created_at, updated_at, sync_status)
VALUES (:id, :fazenda_id, :nome, :agora, :agora, 'PENDENTE');

-- RN-02: toda alteração volta a ficar pendente. created_at não muda.
atualizar:
UPDATE lotes SET fazenda_id = :fazenda_id, nome = :nome, updated_at = :agora, sync_status = 'PENDENTE',
    sync_erro_codigo = NULL, sync_erro_mensagem = NULL
WHERE id = :id;

buscarPorId:
SELECT * FROM lotes WHERE id = ? AND deleted_at IS NULL;

listarPorFazenda:
SELECT * FROM lotes
WHERE fazenda_id = ? AND deleted_at IS NULL
ORDER BY nome COLLATE NOCASE, created_at;
